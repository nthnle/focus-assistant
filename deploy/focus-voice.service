[Unit]
Description=Focus assistant voice (speakerphone play button)
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=audio input
# Root-only (0600) file; holds the API key and FOCUS_SPEECH_DEVICE.
EnvironmentFile=/etc/focus-assistant/focus.env
Environment=FOCUS_STATE_DIR=@STATE_DIR@
Environment=PYTHONUNBUFFERED=1
# Models are downloaded at setup; never fetch them from here.
Environment=HF_HUB_OFFLINE=1
Environment=HF_HOME=/tmp/hf
ExecStart=/opt/focus-assistant/venv/bin/python -m focus.inputs.voice
# Restarts until the speakerphone is plugged back in.
Restart=on-failure
RestartSec=10

# Sound cards, input devices (read) and the state file; calls the API.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=char-input r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
