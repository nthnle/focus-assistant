[Unit]
Description=Focus assistant chat (iPhone Shortcut / Siri)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
# Root-only (0600) file; holds the model provider's key and FOCUS_CHAT_TOKEN.
EnvironmentFile=/etc/focus-assistant/focus.env
Environment=FOCUS_STATE_DIR=@STATE_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/focus-assistant/venv/bin/python -m focus.inputs.chat
Restart=on-failure
RestartSec=5

# Answers token holders on the home network, calls the API, writes only the
# state file. It can change priorities but cannot run commands.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# An empty home with only the state folder in it: nothing else there (SSH
# keys included) is visible even if this service were compromised.
ProtectHome=tmpfs
BindPaths=@STATE_DIR@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# Kernel logs, the clock and the hostname are off limits; other processes in
# /proc are hidden; no setuid files; only the system calls normal services use.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateUsers=yes
UMask=0077

[Install]
WantedBy=multi-user.target
