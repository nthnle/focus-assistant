[Unit]
Description=Focus assistant e-ink display (redraws the Inky Impression when the list or reply changes)

[Service]
Type=simple
User=@USER@
Group=@USER@
# The panel: image data over SPI, its model from an ID chip over I2C, and
# reset/busy/data-command lines over GPIO.
SupplementaryGroups=spi i2c gpio
EnvironmentFile=/etc/focus-assistant/focus.env
# Draws from state.json only: no key, no network.
UnsetEnvironment=FOCUS_LLM_API_KEY
Environment=FOCUS_STATE_DIR=@STATE_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/focus-assistant/venv/bin/python -m focus.outputs.inky --watch
Restart=on-failure
RestartSec=30

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@STATE_DIR@
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-spi rw
DeviceAllow=char-i2c rw
DeviceAllow=char-gpiochip rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# Kernel logs, the clock and the hostname are off limits; other processes in
# /proc are hidden; no setuid files; only the system calls normal services use.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateNetwork=yes
UMask=0077

[Install]
WantedBy=multi-user.target
