[Unit]
Description=Focus assistant back-to-work line (:00 after a break reminder)

[Service]
Type=oneshot
User=@USER@
Group=@USER@
SupplementaryGroups=audio
EnvironmentFile=/etc/focus-assistant/focus.env
# A fixed line, never a model call: no key, no network.
UnsetEnvironment=FOCUS_LLM_API_KEY
Environment=FOCUS_STATE_DIR=@STATE_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/focus-assistant/venv/bin/python -m focus.stretch --back
TimeoutStartSec=2min

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@STATE_DIR@
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# Kernel logs, the clock and the hostname are off limits; other processes in
# /proc are hidden; no setuid files; only the system calls normal services use.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateNetwork=yes
UMask=0077
