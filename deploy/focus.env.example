# /etc/focus-assistant/focus.env  -- owner root:root, mode 0600
# The model: an open model on any OpenAI-compatible host (docs/configuration.md).
FOCUS_LLM_BASE_URL=https://REPLACE_ME/v1   # e.g. https://api.groq.com/openai/v1
FOCUS_LLM_API_KEY=REPLACE_ME
FOCUS_MODEL=REPLACE_ME                     # the provider's name for the model, for check-ins

# Optional overrides
# FOCUS_CHAT_MODEL=                      # chat, voice and stretch; defaults to FOCUS_MODEL
# FOCUS_MODEL_PRICE=0.59,0.79            # US$ per million tokens in,out, for `focus status`
# FOCUS_CHAT_MODEL_PRICE=0.05,0.08
# FOCUS_EFFORT=low                       # reasoning models only; leave unset otherwise
# FOCUS_OUTPUTS=console                 # add ,speech to hear check-ins
# FOCUS_SPEECH_DEVICE=plughw:CARD=PowerConf,DEV=0   # from: aplay -L | grep plughw (also the mic)
# FOCUS_SPEECH_LEAD_MS=300              # silence before speech so a USB speaker wakes up
# FOCUS_VOICE_MODEL=base.en               # or tiny.en, moonshine/tiny, moonshine/base (README, Voice)
# FOCUS_VOICE_WAKE=hey_jarvis             # always listen for the phrase (README, Voice)
# FOCUS_VOICE_WAKE_THRESHOLD=0.5         # higher = fewer false starts
# FOCUS_VOICE_WAKE_FRAMES=3               # frames in a row above it (80 ms each)
# FOCUS_VOICE_WAKE_VAD=0.5               # speech detector; 0 = off
# FOCUS_VOICE_FOLLOWUP=5                 # seconds to keep listening after a reply; 0 = off
# FOCUS_WORKDAYS=mon-fri                 # e.g. sun-thu; days off get a check-in only if you sit down
# FOCUS_CHECKINS=09:00,13:00,17:30        # when morning, midday and evening open
# FOCUS_CHECKIN_UNTIL=20:00               # none after this
# FOCUS_BLOCKS=09:00-12:00,13:00-17:30   # focus time on work days

# Desk camera (docs/camera.md)
# FOCUS_CAMERA_DEVICE=/dev/video0         # from: v4l2-ctl --list-devices
# FOCUS_CAMERA_EVERY=2                    # seconds between frames
# FOCUS_CAMERA_MJPEG=1                    # 0 if the camera refuses MJPEG
# FOCUS_CAMERA_MODEL=                     # default: <state folder>/camera/model.onnx
# FOCUS_PHONE_NUDGE_MIN=5                 # minutes on the phone before the coach says so; 0: off
# FOCUS_AWAY_CAMERA_MIN=5                 # away = the camera sees the empty desk this long

# Network services. install.sh adds FOCUS_CHAT_TOKEN and FOCUS_DISPLAY_TOKEN for you.
# FOCUS_CHAT_PORT=8766
# FOCUS_PAGE_PORT=8765
# FOCUS_ALLOWED_CLIENTS=192.168.1.50      # only these devices may use the page and chat
# FOCUS_LOG_WORDS=1                       # log what you say (off: only its length)
