# /etc/focus-assistant/focus.env  -- owner root:root, mode 0600
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional overrides
# FOCUS_MODEL=claude-sonnet-5-5
# FOCUS_EFFORT=low
# FOCUS_OUTPUTS=console

# Phone dock (focus-dock service). install.sh adds FOCUS_DOCK_TOKEN for you.
# FOCUS_BLOCKS=09:00-12:00,13:00-17:30   # focus time, weekdays; phone use counts only here
# FOCUS_DOCK_PORT=8765
# FOCUS_DOCK_SETTLE=30                   # seconds off the charger before it counts
