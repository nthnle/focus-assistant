# /etc/focus-assistant/focus.env  -- owner root:root, mode 0600
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional overrides
# FOCUS_MODEL=claude-sonnet-5-5          # check-ins
# FOCUS_CHAT_MODEL=claude-haiku-5-5       # phone chat and voice: quicker, ~20x cheaper
# FOCUS_EFFORT=low
# FOCUS_OUTPUTS=console                 # add ,speech to hear check-ins
# FOCUS_SPEECH_DEVICE=plughw:CARD=PowerConf,DEV=0   # from: aplay -L | grep plughw (also the mic)
# FOCUS_VOICE_MODEL=base.en               # or tiny.en, moonshine/tiny, moonshine/base (README, Voice)
# FOCUS_VOICE_WAKE=hey_jarvis             # always listen for the phrase (README, Voice)
# FOCUS_VOICE_WAKE_THRESHOLD=0.5         # higher = fewer false starts
# FOCUS_VOICE_WAKE_FRAMES=3               # frames in a row above it (80 ms each)
# FOCUS_VOICE_WAKE_VAD=0.5               # speech detector; 0 = off
# FOCUS_VOICE_FOLLOWUP=5                 # seconds to keep listening after a reply; 0 = off
# FOCUS_AWAY_PHONE_MIN=10                # away = phone off the dock this long...
# FOCUS_AWAY_QUIET_MIN=15                # ...and the desk quiet this long

# Phone services. install.sh adds FOCUS_DOCK_TOKEN, FOCUS_CHAT_TOKEN and FOCUS_DISPLAY_TOKEN for you.
# FOCUS_CHAT_PORT=8766
# FOCUS_CHAT_DAILY_LIMIT=50               # chat messages per day, a cost cap
# FOCUS_BLOCKS=09:00-12:00,13:00-17:30   # focus time, weekdays; phone use counts only here
# FOCUS_DOCK_PORT=8765
# FOCUS_DOCK_SETTLE=30                   # seconds off the charger before it counts
