[Unit]
Description=Focus assistant check-ins (morning, midday, end of day; once you sit down at the desk)

[Timer]
# A tick, not a check-in: every 5 minutes focus.schedule looks whether one is
# due (FOCUS_CHECKINS, FOCUS_CHECKIN_UNTIL) and whether you're at the desk,
# and exits quietly when not. Keep those times inside these hours.
OnCalendar=*-*-* 07..21:00/5
AccuracySec=10s
# A missed tick is stale: the next one is 5 minutes away.
Persistent=false
Unit=focus-checkin-tick.service

[Install]
WantedBy=timers.target
