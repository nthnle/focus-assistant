[Unit]
Description=Focus assistant stretch reminder
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
SupplementaryGroups=audio
# Root-only (0600) file; the coach writes the reminder, so it needs the key.
EnvironmentFile=/etc/focus-assistant/focus.env
Environment=FOCUS_STATE_DIR=@STATE_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/focus-assistant/venv/bin/python -m focus.stretch
TimeoutStartSec=2min

# Sound cards and the state file; calls the API (falls back offline).
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# An empty home with only the state folder in it: nothing else there (SSH
# keys included) is visible even if this service were compromised.
ProtectHome=tmpfs
BindPaths=@STATE_DIR@
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-alsa rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# Kernel logs, the clock and the hostname are off limits; other processes in
# /proc are hidden; no setuid files; only the system calls normal services use.
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
